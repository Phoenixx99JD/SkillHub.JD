@page
@model SkillHub.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = L["Registrarse"];
    ViewData["AsideTitle"] = L["Únete a SkillHub y empieza a aprender con práctica real."];
}

<div class="container">
    <div class="auth-shell">
        <partial name="_AuthAside" />
        <div class="auth-form">
            <h1 class="mb-1">@L["Crea tu cuenta"]</h1>
            <p class="text-muted mb-4">@L["Te toma menos de un minuto."]</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label">@L["Nombre completo"]</label>
                    <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">@L["Correo electrónico"]</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="@L["tu@correo.com"]" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-sm-6">
                        <label asp-for="Input.Password" class="form-label">@L["Contraseña"]</label>
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.ConfirmPassword" class="form-label">@L["Confirmar contraseña"]</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-text mb-4">@L["Mínimo 8 caracteres, con una mayúscula, una minúscula y un número."]</div>
                <button type="submit" class="btn btn-brand btn-lg-form w-100">@L["Registrarse"] @Icons.Get("arrow-right")</button>
            </form>
            <p class="text-center small text-muted mt-4 mb-0">
                @L["¿Ya tienes una cuenta?"] <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">@L["Inicia sesión"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
