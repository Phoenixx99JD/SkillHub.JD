@page
@{
    ViewData["Title"] = L["Acceso denegado"];
}
<div class="container py-5">
    <div class="empty-state">
        <span class="empty-icon">@Icons.Get("lock", "icon icon-lg")</span>
        <h1 class="h4">@L["Acceso denegado"]</h1>
        <p class="text-muted">@L["Esta sección solo está disponible para participantes."]</p>
        <a asp-page="/Index" class="btn btn-brand">@Icons.Get("arrow-left") @L["Volver a los talleres"]</a>
    </div>
</div>
