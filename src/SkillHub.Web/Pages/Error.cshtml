@page
@model ErrorModel
@{
    ViewData["Title"] = L["Error"];
}

<div class="container py-5">
    <div class="empty-state">
        <span class="empty-icon">@Icons.Get("x", "icon icon-lg")</span>
        <h1 class="h4">@L["Algo salió mal"]</h1>
        <p class="text-muted">@L["Ocurrió un error al procesar tu solicitud. Inténtalo de nuevo en unos minutos."]</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted"><strong>@L["ID de la solicitud:"]</strong> <code>@Model.RequestId</code></p>
        }
        <a asp-page="/Index" class="btn btn-brand">@Icons.Get("arrow-left") @L["Volver a los talleres"]</a>
    </div>
</div>
